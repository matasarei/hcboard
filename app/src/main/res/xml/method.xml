<?xml version="1.0" encoding="utf-8"?>
<!--
    No language subtypes on purpose: languages live in the keyboard's own settings and on its globe
    key. Declaring them here too gave Android a second list, filled from the phone's languages, that
    the keyboard's settings did not agree with, and a picker whose choice never reached the keys.

    The one subtype below exists because Android's keyboard list shows the enabled subtypes' names
    as the line under a keyboard's name (android:description on the service is never shown), and
    with no subtype that line stayed empty. Always on, so it needs no picker. It is English, which
    the keyboard always has: stock Android showed the label of a subtype with no language, but
    Samsung's list left it out, and every keyboard it does describe declares one.
-->
<input-method xmlns:android="http://schemas.android.com/apk/res/android"
    android:settingsActivity="net.matasar.keyboard.settings.SettingsActivity"
    android:supportsInlineSuggestions="true"
    android:supportsSwitchingToNextInputMethod="true">

    <!--
        A fixed subtypeId: Android otherwise hashes one from the locale, mode and flags, and a later
        change to any of them would make this a different subtype to enable again. The label is not
        part of that hash, so rewording it is free either way.
    -->
    <subtype
        android:label="@string/ime_description"
        android:subtypeId="0x68630001"
        android:imeSubtypeLocale="en_US"
        android:languageTag="en-US"
        android:imeSubtypeMode="keyboard"
        android:isAsciiCapable="true"
        android:overridesImplicitlyEnabledSubtype="true" />
</input-method>
