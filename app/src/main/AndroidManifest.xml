<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The key button names the password manager the user picked and opens it, and package
         visibility hides every other app by default: without this the sheet cannot read the
         manager's name or launch it, and says no manager is set. Only apps that offer autofill or
         credentials are made visible, not every installed package. The actions reach a manager
         only through exported services; the managers below are named as well, because one that
         keeps its services unexported (Enpass does) would stay hidden, and the sheet would drop
         the user's choice and list every other manager instead. -->
    <queries>
        <intent>
            <action android:name="android.service.autofill.AutofillService" />
        </intent>
        <intent>
            <action android:name="android.service.credentials.CredentialProviderService" />
        </intent>
        <package android:name="io.enpass.app" />
        <package android:name="com.x8bit.bitwarden" />
        <package android:name="com.onepassword.android" />
        <package android:name="proton.android.pass" />
        <package android:name="com.dashlane" />
        <package android:name="com.lastpass.lpandroid" />
        <package android:name="com.callpod.android_apps.keeper" />
        <package android:name="com.kunzisoft.keepass.free" />
        <package android:name="com.kunzisoft.keepass.libre" />
        <package android:name="keepass2android.keepass2android" />
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".onboarding.EnableActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".settings.SettingsActivity"
            android:exported="true"
            android:label="@string/settings_title"
            android:windowSoftInputMode="adjustResize" />

        <!-- Where macros are built from blocks; opened from settings and from the keyboard's macro sheet. -->
        <activity
            android:name=".macro.MacrosActivity"
            android:exported="false"
            android:label="@string/macros_title"
            android:windowSoftInputMode="adjustResize" />

        <!-- Where the user adds words to the dictionaries or blocks them; opened from settings. -->
        <activity
            android:name=".settings.CustomWordsActivity"
            android:exported="false"
            android:label="@string/words_title"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".settings.LanguagesActivity"
            android:exported="false"
            android:label="@string/languages_title" />

        <!-- The licence and notice texts the APK carries; opened from settings. -->
        <activity
            android:name=".settings.LicencesActivity"
            android:exported="false"
            android:label="@string/licences_title" />

        <!-- The fill screen: a login form for the password manager, opened only by the keyboard.
             Its own task, so closing it lands back in the app the password is for; kept out of
             recents and history, so it is never a way back to a filled form. -->
        <activity
            android:name=".autofill.FillActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity="net.matasar.keyboard.fill"
            android:label="@string/fill_title"
            android:theme="@style/Theme.Hcboard.Fill"
            android:windowSoftInputMode="stateAlwaysVisible|adjustResize" />

        <service
            android:name=".ime.KeyboardService"
            android:exported="true"
            android:label="@string/ime_label"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>
    </application>

</manifest>
